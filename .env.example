# Copy to .env and fill in. Every variable the server reads is listed here;
# values in (parentheses) are the defaults used when a variable is unset.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string. Hosted databases (Neon, Render) use SSL automatically;
# a local Postgres without SSL needs ?sslmode=disable.
DATABASE_URL=postgres://user:pass@localhost:5432/realm_of_dominion?sslmode=disable

# Signs login tokens. Use a long random string (32+ chars); never commit the real one.
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# ── Server ────────────────────────────────────────────────────────────────
# (5000)
PORT=5000
# "production" on the host. Read by Express, not by this repo's code.
NODE_ENV=development
# Where players open the game: allowed CORS origin, and the base of links in emails.
# Dev: the Vite dev server (client/vite.config.js, port 3001). Prod: the public site URL.
# (CORS: http://localhost:3000, email links: https://realmofdominion.com)
CLIENT_URL=http://localhost:3001
# How long a login lasts (7d)
JWT_EXPIRES_IN=7d

# ── Game tuning ───────────────────────────────────────────────────────────
# Minutes per action point regenerated (15)
AP_REGEN_MINUTES=30
# Action point cap (20)
MAX_AP=20
# Attack/spell protection for new players, in hours (24)
NEWBIE_PROTECTION_HOURS=24
# Season length in days, used by the rollover and the age seed (7).
# AGE_LENGTH_DAYS is an older name the age seed still accepts.
SEASON_LENGTH_DAYS=7

# ── Email: password reset and email change ────────────────────────────────
# Without these, those emails fail and are logged; the endpoints still respond normally.
SMTP_HOST=
# (587)
SMTP_PORT=587
# true for implicit TLS on port 465 (false)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# (Realm of Dominion <noreply@realmofdominion.com>)
EMAIL_FROM="Realm of Dominion <noreply@realmofdominion.com>"

# ── Admin ─────────────────────────────────────────────────────────────────
# Bearer token for the bot admin API (/api/bots/*). Leave empty to disable it.
ADMIN_SECRET=
